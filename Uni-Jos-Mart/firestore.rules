rules_version='2';
service cloud.firestore{match /databases/{d}/documents{
 function ok(){return request.auth!=null}
 function adm(){return ok()&&exists(/databases/$(d)/documents/admins/$(request.auth.uid))}
 function mem(c){return request.auth.uid in get(/databases/$(d)/documents/chats/$(c)).data.participants}
 match /users/{u}{allow read:if ok()&&(request.auth.uid==u||adm());allow write:if ok()&&request.auth.uid==u;match /saved/{s}{allow read,write:if ok()&&request.auth.uid==u}}
 match /reports/{r}{allow read,delete:if adm();allow create:if ok()&&request.resource.data.by==request.auth.uid&&request.resource.data.reason.size()<=300}
 match /reviews/{c}{allow read:if true;allow create:if ok()&&request.resource.data.buyerId==request.auth.uid&&request.resource.data.stars is int&&request.resource.data.stars>=1&&request.resource.data.stars<=5&&request.resource.data.text.size()<=200&&get(/databases/$(d)/documents/chats/$(c)).data.done==true&&get(/databases/$(d)/documents/chats/$(c)).data.participants==[request.auth.uid,request.resource.data.sellerId]}
 match /publicUsers/{u}{allow read:if true;allow write:if ok()&&request.auth.uid==u}
 match /matrics/{m}{allow create:if ok()&&request.resource.data.uid==request.auth.uid}
 match /verified/{u}{allow read:if true;allow write:if adm()}
 match /admins/{u}{allow read:if ok()&&request.auth.uid==u}
 match /items/{i}{allow read:if true;
  allow create:if ok()&&request.resource.data.sellerId==request.auth.uid&&request.resource.data.price is int&&request.resource.data.price>=0&&request.resource.data.title.size()<=80&&request.resource.data.description.size()<=800&&request.resource.data.images.size()<=4;
  allow update:if ok()&&resource.data.sellerId==request.auth.uid&&request.resource.data.sellerId==request.auth.uid;
  allow delete:if ok()&&(resource.data.sellerId==request.auth.uid||adm())}
 match /chats/{c}{allow read:if ok()&&request.auth.uid in resource.data.participants;
  allow create:if ok()&&request.auth.uid in request.resource.data.participants&&request.resource.data.participants.size()==2;
  allow update:if ok()&&request.auth.uid in resource.data.participants&&(request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMsg','updated','lastFrom','seen'])||(request.auth.uid==resource.data.participants[1]&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done'])));
  match /messages/{m}{allow read:if ok()&&mem(c);
   allow create:if ok()&&mem(c)&&request.resource.data.from==request.auth.uid&&request.resource.data.text.size()<=500&&(request.resource.data.text.size()>0||request.resource.data.img!='')}}}}
